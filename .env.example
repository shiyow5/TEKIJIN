# TEKIJIN 環境変数のひな型。.env にコピーして設定する（.env は git 管理外）。
# 変数はすべて TEKIJIN_ プレフィックス（backend の pydantic-settings 設定に対応）。
# 値を有効化するときは行頭の # を外す。

# アプリ環境
# TEKIJIN_APP_ENV=development

# データベース（PostgreSQL + pgvector。docker-compose の db サービス）
# TEKIJIN_DATABASE_URL=postgresql+psycopg://tekijin:tekijin@localhost:5432/tekijin

# LLM（vLLM / OpenAI 互換 /v1。DGX Spark 上、Tailscale 経由）
# TEKIJIN_LLM_BASE_URL=http://internship-dgx1:8080/v1
# TEKIJIN_LLM_MODEL=Qwen3.6-35B-A3B-NVFP4
# TEKIJIN_LLM_API_KEY=dummy

# 埋め込みモデル（ローカル sentence-transformers）。既定は Nemotron-3-Embed-1B（2048次元）。
# モデルを替えるときは EMBEDDING_DIM もそのモデルの次元へ必ず合わせること
# （不一致だと make embed が verify_embedding_width で即失敗する）。
# 例: 1024次元モデルに戻すなら以下2行を一緒に設定する。
# TEKIJIN_EMBEDDING_MODEL=nvidia/Nemotron-3-Embed-1B-BF16
# TEKIJIN_EMBEDDING_DIM=2048

# 埋め込みモデルのリモートコード実行許可（load時 trust_remote_code）。
# 既定の Nemotron はカスタムモデリングコードを持つため true が必須。
# 信頼できないモデルを指すときは false にする（セキュリティ）。
# TEKIJIN_EMBEDDING_TRUST_REMOTE_CODE=true

# 埋め込み時の e5 プレフィクス（query: / passage:）の有無。
# e5 系と Nemotron（既定）は true。ruri / Qwen3-Embedding など非対応モデルは false。
# TEKIJIN_EMBEDDING_USE_E5_PREFIX=true

# CORS 許可オリジン（JSON 配列）
# TEKIJIN_CORS_ORIGINS=["http://localhost:3000"]
