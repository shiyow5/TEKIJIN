# TEKIJIN 環境変数のひな型。.env にコピーして設定する（.env は git 管理外）。
# 変数はすべて TEKIJIN_ プレフィックス（backend の pydantic-settings 設定に対応）。
# 値を有効化するときは行頭の # を外す。

# アプリ環境
# TEKIJIN_APP_ENV=development

# データベース（PostgreSQL + pgvector。docker-compose の db サービス）
# TEKIJIN_DATABASE_URL=postgresql+psycopg://tekijin:tekijin@localhost:5432/tekijin

# LLM（vLLM / OpenAI 互換 /v1。DGX Spark 上、Tailscale 経由）
# TEKIJIN_LLM_BASE_URL=http://internship-dgx1:8080/v1
# TEKIJIN_LLM_MODEL=Qwen3.6-35B-A3B-NVFP4
# TEKIJIN_LLM_API_KEY=dummy
# reasoning モデル(Qwen3)の <think> を出すか。既定 false（構造化出力の安定と低レイテンシのため）。
# serve 側は --tool-call-parser hermes --enable-auto-tool-choice --reasoning-parser qwen3 が必須。
# TEKIJIN_LLM_ENABLE_THINKING=false

# 埋め込みモデル（ローカル sentence-transformers）。
# 既定は nvidia/Nemotron-3-Embed-1B-BF16（2048次元、trust_remote_code 必須）＝コード側の
# 既定値なので、そのまま使うなら何も設定しなくてよい。
# モデルを替えるときは EMBEDDING_DIM もそのモデルの次元へ必ず合わせること
# （不一致だと make embed が verify_embedding_width で即失敗する）。
#
# 退避先として 1024次元・Apache-2.0 の Qwen3-Embedding-0.6B に切り替える例。
# #61 の Qwen ベンチはクエリに指示プレフィクス、パッセージに無しを付けているので、
# 実測値を再現するには per-kind の指示プレフィクスを設定する（#108）。
# TEKIJIN_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# TEKIJIN_EMBEDDING_DIM=1024
# TEKIJIN_EMBEDDING_TRUST_REMOTE_CODE=false
# per-kind 指示プレフィクス（下記 EMBEDDING_QUERY_PREFIX / _PASSAGE_PREFIX を参照）。
# \n を実際の改行にするには値をダブルクォートで囲むこと（python-dotenv のエスケープ解釈）:
# TEKIJIN_EMBEDDING_QUERY_PREFIX="Instruct: 社内の相談内容に対して、詳しい社員や関連する社内資料を検索する\nQuery: "
# TEKIJIN_EMBEDDING_PASSAGE_PREFIX=
# 注意: 指示プレフィクスを設定すると EMBEDDING_USE_E5_PREFIX より優先される（下記）。

# 埋め込みモデルのリモートコード実行許可（load時 trust_remote_code）。
# 既定の Nemotron はカスタムモデリングコードを持つため true が必須。
# 信頼できないモデルを指すときは false にする（セキュリティ）。
# TEKIJIN_EMBEDDING_TRUST_REMOTE_CODE=true

# 実行するモデルのリビジョン固定（HF の commit SHA / タグ）。未設定=default ブランチ。
# fail-closed（#108）: APP_ENV が development 以外で TRUST_REMOTE_CODE=true かつ本項が
# 未設定だと、起動時に拒否される（default ブランチのコードを毎回実行するのを防ぐ）。
# 本番では監査済みリビジョンを固定するか、TRUST_REMOTE_CODE=false にすること。
# TEKIJIN_EMBEDDING_MODEL_REVISION=

# 埋め込み時の e5 プレフィクス（query: / passage:）の有無。
# e5 系と Nemotron（既定）は true。ruri / Qwen3-Embedding など非対応モデルは false。
# per-kind の指示プレフィクス（下記）を設定した kind では、そちらが優先される。
# TEKIJIN_EMBEDDING_USE_E5_PREFIX=true

# per-kind の指示プレフィクス（kind ごとに e5 プレフィクスを上書き）。
# 未設定=USE_E5_PREFIX に従う。空文字は「プレフィクス無し」を意味する明示的な上書き。
# 指示チューニング済みモデル（Qwen 等）の検索設定を再現するために使う（上の Qwen 例参照）。
# TEKIJIN_EMBEDDING_QUERY_PREFIX=
# TEKIJIN_EMBEDDING_PASSAGE_PREFIX=

# CORS 許可オリジン（JSON 配列）
# TEKIJIN_CORS_ORIGINS=["http://localhost:3000"]

# Slack連携（チャット↔Slack、#388・#hand-off-chat）。
# 未設定の間は機能自体が無効（GET /slack/authorize-url が503を返す）。
# 「チャットで相談する」の依頼を承諾すると、依頼者・責任者2人だけのプライベート
# チャンネル（Botも参加）が自動作成され、下書きがそこに投稿される。以降は
# そのチャンネルでのやり取りがTEKIJINチャットにも自動反映される。同じ相手と
# 再度チャットで相談した場合は、新しいチャンネルではなく既存のものを再利用する。
#
# Slack App（https://api.slack.com/apps）を作成し、以下を設定すると有効になる:
# - Redirect URL に TEKIJIN_SLACK_REDIRECT_URI（このバックエンドの
#   GET /slack/oauth/callback）を登録
# - User Token Scopes に identity.basic を追加（アカウント連携用）
# - Bot Token Scopes に groups:write（プライベートチャンネルの作成・招待）/
#   chat:write（投稿）/ groups:history（Events APIでのメッセージ受信）を追加し、
#   インストール後の Bot User OAuth Token（xoxb-...）を TEKIJIN_SLACK_BOT_TOKEN に設定
#   （連携(linking)自体はBotトークンなしでも動作するが、チャンネル作成・投稿は行われない）
# TEKIJIN_SLACK_CLIENT_ID=
# TEKIJIN_SLACK_CLIENT_SECRET=
# TEKIJIN_SLACK_REDIRECT_URI=http://localhost:8000/slack/oauth/callback
# TEKIJIN_SLACK_BOT_TOKEN=
# TEKIJIN_SLACK_FRONTEND_URL=http://localhost:3000
#
# Slack→TEKIJIN方向（Slackで話した内容をTEKIJINチャットに取り込む）を使うには、
# 加えて以下が必要:
# - Slack App の「Basic Information」にある Signing Secret を
#   TEKIJIN_SLACK_SIGNING_SECRET に設定（POST /slack/events のリクエスト署名検証に使う）
# - 「Event Subscriptions」を有効化し、Request URL にこのバックエンドの
#   POST /slack/events を設定（Slackはlocalhostを直接呼べないため、ローカル開発では
#   ngrok 等でトンネルした公開URLを指定する）
# - Subscribe to bot events に message.groups を追加
# TEKIJIN_SLACK_SIGNING_SECRET=
#
# 連携を受け付けるワークスペースを1つに限定する（#406）。
# Slack の OAuth は「このクライアントIDに対して」どのワークスペースの人でも
# 認証してしまうので、戻ってきた team を照合しないと、
# コールバックURLを知った他ワークスペースの人が連携できる。
# 空 = どのワークスペースでも受け付ける（ローカル/デモ用の既定）。
# 値は auth.test か App の Basic Information から取得する（T で始まる）。
# TEKIJIN_SLACK_TEAM_ID=
#
# 「Slackでログイン」を有効にする（#406 案A）。既定は無効。
# 有効にすると「そのワークスペースに居ること」がログイン権限そのものになるので、
# TEKIJIN_SLACK_TEAM_ID が未設定だと**バックエンドが起動を拒否する**。
# ログインできるのは slack_links に行がある社員だけ。
# TEKIJIN_SLACK_LOGIN_ENABLED=true
#
# Slack ワークスペースを社員名簿の正とし、slack_links を突き合わせる（#406 step 3）。
# 既定は無効。有効化は POST /slack/sync-users（管理者のみ）を cron で叩く形で、
# 1時間おきで十分（取りこぼしても次回で復旧する自己修復的な同期）。
# users:read と users:read.email のスコープが要る（後者が無いと
# profile.email が返らず、誰一人マッチしない）。
#
# ⚠️ 証拠の取り込み（#404）より先に有効化しないこと。Slack がくれるのは「人」だけで
# 「証拠」ではないので、先に全員を登録すると topic_fit=0 の社員が N 人できる。
# 候補だけ増えて信号がゼロになり、画面は賑やかなのに推薦は悪くなる。
# TEKIJIN_SLACK_USER_SYNC_ENABLED=true

# --- FastAPI 自動ドキュメント ------------------------------------------------
# /docs・/redoc・/openapi.json。既定は無効（塞がれている）。
#
# /openapi.json は全エンドポイントのパス・パラメータ・型を返すので、
# 公開環境では保護済みエンドポイントの一覧まで読まれてしまう。設定漏れが
# そのまま露出になるため、既定を「塞ぐ」側にしてある（#457）。
#
# app_env とは連動しない。DGX は別の理由で app_env=development のまま運用して
# いるので（#108/#173）、app_env で分岐すると本番で塞がらない。
#
# 手元で Swagger UI を見たいときだけ true にする。
# TEKIJIN_EXPOSE_API_DOCS=true
